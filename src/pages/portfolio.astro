---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'Voorbeeld Project 1',
    description: 'Een uitgebreid .NET project met Azure integratie voor het beheren van cloud resources.',
    url: 'https://github.com/roblohmann/project1',
    technologies: ['.NET', 'Azure', 'C#', 'Docker'],
    featured: true,
    stars: 42,
    forks: 12,
  },
  {
    name: 'Kubernetes Tool',
    description: 'Een handige CLI tool voor het beheren van Kubernetes clusters en het automatiseren van deployment workflows.',
    url: 'https://github.com/roblohmann/k8s-tool',
    technologies: ['Kubernetes', 'Go', 'CLI'],
    featured: true,
    stars: 128,
    forks: 24,
  },
  {
    name: 'PostgreSQL Utilities',
    description: 'Een verzameling scripts en tools voor PostgreSQL database management en optimalisatie.',
    url: 'https://github.com/roblohmann/postgres-utils',
    technologies: ['PostgreSQL', 'Python', 'SQL'],
    stars: 67,
    forks: 15,
  },
  {
    name: 'Azure DevOps Extensions',
    description: 'Custom extensions voor Azure DevOps pipelines om CI/CD workflows te verbeteren.',
    url: 'https://github.com/roblohmann/azdo-extensions',
    technologies: ['Azure DevOps', 'TypeScript', 'Node.js'],
    stars: 34,
    forks: 8,
  },
  {
    name: 'MVC Blog Engine',
    description: 'Een legacy ASP.NET MVC blog engine met RSS feeds en XML sitemap ondersteuning.',
    url: 'https://github.com/roblohmann/mvc-blog',
    technologies: ['ASP.NET MVC', 'C#', 'SQL Server'],
    stars: 18,
    forks: 5,
  },
  {
    name: 'Docker Compose Templates',
    description: 'Een collectie van Docker Compose templates voor verschillende development scenarios.',
    url: 'https://github.com/roblohmann/docker-templates',
    technologies: ['Docker', 'Docker Compose', 'YAML'],
    stars: 91,
    forks: 23,
  },
];
---

<Layout 
  title="Portfolio - Rob Lohmann" 
  description="Mijn GitHub projecten en open source bijdragen"
>
  <section class="max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-16">
    <div class="mb-16">
      <h1 class="text-5xl md:text-6xl font-extrabold mb-6 text-gray-900 dark:text-white border-l-4 border-secondary pl-6 leading-tight">Portfolio</h1>
      <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 max-w-3xl">
        Een selectie van mijn projecten en bijdragen op GitHub. Van cloud automation tot database tools.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, index) => (
        <article 
          class="group bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl p-6 hover:shadow-xl hover:shadow-secondary/10 hover:-translate-y-2 transition-all duration-300 fade-in"
          style={`animation-delay: ${index * 50}ms`}
        >
          {project.featured && (
            <div class="mb-3">
              <span class="inline-flex items-center gap-1 px-3 py-1 bg-gradient-to-r from-secondary to-primary text-white rounded-full text-xs font-bold">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
                Featured
              </span>
            </div>
          )}
          
          <div class="flex items-start justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white flex-1 group-hover:text-secondary transition-colors">
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2">
                {project.name}
                <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            </h2>
            <svg class="w-6 h-6 text-gray-400 dark:text-gray-500 group-hover:text-secondary transition-colors flex-shrink-0 ml-2" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          
          <p class="text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">{project.description}</p>
          
          <div class="flex items-center gap-4 mb-4 text-sm text-gray-600 dark:text-gray-400">
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              {project.stars}
            </span>
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.707 3.293a1 1 0 010 1.414L5.414 7H11a7 7 0 017 7v2a1 1 0 11-2 0v-2a5 5 0 00-5-5H5.414l2.293 2.293a1 1 0 11-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
              {project.forks}
            </span>
          </div>
          
          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="px-3 py-1 bg-teal-50 dark:bg-teal-900/30 text-secondary dark:text-teal-300 rounded-full text-xs font-semibold border border-secondary/20">
                {tech}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 text-center bg-gradient-to-br from-white to-blue-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-12 border border-gray-200 dark:border-gray-700 shadow-xl">
      <h2 class="text-3xl font-bold mb-4 text-gray-900 dark:text-white">Meer projecten</h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
        Bekijk al mijn projecten en bijdragen op GitHub voor meer code samples en experimenten.
      </p>
      <a 
        href="https://github.com/roblohmann" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-dark dark:bg-gray-700 text-white rounded-xl hover:bg-gray-700 dark:hover:bg-gray-600 transition-all font-semibold shadow-lg hover:shadow-xl hover:-translate-y-0.5 text-lg"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        Bezoek mijn GitHub Profiel
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>
