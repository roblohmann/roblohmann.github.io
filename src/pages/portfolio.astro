---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    name: 'Voorbeeld Project 1',
    description: 'Een uitgebreid .NET project met Azure integratie voor het beheren van cloud resources.',
    url: 'https://github.com/roblohmann/project1',
    technologies: ['.NET', 'Azure', 'C#', 'Docker'],
    featured: true
  },
  {
    name: 'Kubernetes Tool',
    description: 'Een handige CLI tool voor het beheren van Kubernetes clusters en het automatiseren van deployment workflows.',
    url: 'https://github.com/roblohmann/k8s-tool',
    technologies: ['Kubernetes', 'Go', 'CLI'],
    featured: true
  },
  {
    name: 'PostgreSQL Utilities',
    description: 'Een verzameling scripts en tools voor PostgreSQL database management en optimalisatie.',
    url: 'https://github.com/roblohmann/postgres-utils',
    technologies: ['PostgreSQL', 'Python', 'SQL'],
  },
  {
    name: 'Azure DevOps Extensions',
    description: 'Custom extensions voor Azure DevOps pipelines om CI/CD workflows te verbeteren.',
    url: 'https://github.com/roblohmann/azdo-extensions',
    technologies: ['Azure DevOps', 'TypeScript', 'Node.js'],
  },
  {
    name: 'MVC Blog Engine',
    description: 'Een legacy ASP.NET MVC blog engine met RSS feeds en XML sitemap ondersteuning.',
    url: 'https://github.com/roblohmann/mvc-blog',
    technologies: ['ASP.NET MVC', 'C#', 'SQL Server'],
  },
  {
    name: 'Docker Compose Templates',
    description: 'Een collectie van Docker Compose templates voor verschillende development scenarios.',
    url: 'https://github.com/roblohmann/docker-templates',
    technologies: ['Docker', 'Docker Compose', 'YAML'],
  },
];
---

<Layout 
  title="Portfolio - Rob Lohmann" 
  description="Mijn GitHub projecten en open source bijdragen"
>
  <section class="max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-16">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900 border-l-4 border-secondary pl-4">Portfolio</h1>
      <p class="text-xl text-gray-600">
        Een selectie van mijn projecten en bijdragen op GitHub. Van cloud automation tot database tools.
      </p>
    </div>

    <ProjectCard projects={projects} />

    <div class="mt-12 text-center bg-white rounded-lg p-8 border border-gray-200">
      <h2 class="text-2xl font-bold mb-4 text-gray-900">Meer projecten</h2>
      <p class="text-gray-700 mb-6">
        Bekijk al mijn projecten en bijdragen op GitHub voor meer code samples en experimenten.
      </p>
      <a 
        href="https://github.com/roblohmann" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-block px-8 py-3 bg-dark text-white rounded-lg hover:bg-gray-700 transition-colors font-medium"
      >
        Bezoek mijn GitHub Profiel →
      </a>
    </div>
  </section>
</Layout>
