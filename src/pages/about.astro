---
import Layout from '../layouts/Layout.astro';

const expertise = [
  { 
    name: '.NET & C#', 
    description: 'Backend development met moderne .NET frameworks',
    level: 95, 
    icon: '💎',
    color: 'primary'
  },
  { 
    name: 'Azure & Cloud Development', 
    description: 'Cloud architectuur en Azure services',
    level: 90, 
    icon: '☁️',
    color: 'secondary'
  },
  { 
    name: 'Kubernetes & Docker', 
    description: 'Container orchestration en deployment',
    level: 85, 
    icon: '⚓',
    color: 'accent'
  },
  { 
    name: 'SQL & PostgreSQL', 
    description: 'Database design en optimalisatie',
    level: 85, 
    icon: '🐘',
    color: 'dark'
  },
  { 
    name: 'Modern Web Development', 
    description: 'Frontend frameworks en tooling',
    level: 80, 
    icon: '📘',
    color: 'gray'
  },
  { 
    name: 'DevOps & CI/CD', 
    description: 'Automation en deployment pipelines',
    level: 88, 
    icon: '🔧',
    color: 'primary'
  },
];
---

<Layout 
  title="Over mij - Rob Lohmann" 
  description="Meer informatie over Rob Lohmann"
>
  <section class="max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-16">
    <h1 class="text-5xl md:text-6xl font-extrabold mb-8 text-gray-900 dark:text-white border-l-4 border-primary pl-6 leading-tight">Over mij</h1>
    <div class="prose prose-lg dark:prose-invert max-w-none mb-16">
      <p class="text-xl md:text-2xl text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
        Hi, ik ben Rob Lohmann, een software developer met een passie voor .NET, Azure, en moderne web development.
      </p>
    </div>
  </section>
  
  <section class="max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-16 bg-white dark:bg-gray-900 transition-colors">
    <h2 class="text-4xl font-bold mb-12 text-gray-900 dark:text-white border-l-4 border-primary pl-6">Skills & Expertise</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {expertise.map((skill, index) => (
        <div 
          class={`group bg-gradient-to-br from-blue-50 to-white dark:from-gray-800 dark:to-gray-900 rounded-xl p-6 border-2 ${
            skill.color === 'primary' ? 'border-primary dark:border-primary/50' :
            skill.color === 'secondary' ? 'border-secondary dark:border-secondary/50' :
            skill.color === 'accent' ? 'border-accent dark:border-accent/50' :
            skill.color === 'dark' ? 'border-dark dark:border-gray-600' :
            'border-gray-400 dark:border-gray-600'
          } hover:shadow-xl hover:-translate-y-2 transition-all duration-300 fade-in`}
          style={`animation-delay: ${index * 100}ms`}
        >
          <div class="text-5xl mb-4 group-hover:scale-110 transition-transform">{skill.icon}</div>
          <h3 class={`font-bold text-xl mb-2 ${
            skill.color === 'primary' ? 'text-primary dark:text-primary' :
            skill.color === 'secondary' ? 'text-secondary dark:text-secondary' :
            skill.color === 'accent' ? 'text-accent dark:text-blue-400' :
            skill.color === 'dark' ? 'text-dark dark:text-gray-300' :
            'text-gray-700 dark:text-gray-300'
          }`}>{skill.name}</h3>
          <p class="text-gray-600 dark:text-gray-400 mb-4 text-sm leading-relaxed">{skill.description}</p>
          <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
            <div 
              class="h-full bg-gradient-to-r from-primary to-secondary rounded-full transition-all duration-1000 skill-bar"
              style={`width: 0%`}
              data-level={skill.level}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </section>
  
  <section class="max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-16">
    <h2 class="text-4xl font-bold mb-8 text-gray-900 dark:text-white border-l-4 border-primary pl-6">Contact</h2>
    <p class="text-xl text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
      Je kunt me vinden op GitHub en LinkedIn. Ik ben altijd open voor interessante projecten en samenwerkingen.
    </p>
    <div class="flex gap-4">
      <a href="https://github.com/roblohmann" target="_blank" rel="noopener noreferrer" 
         class="inline-flex items-center gap-2 px-8 py-4 bg-dark dark:bg-gray-700 text-white rounded-xl hover:bg-gray-700 dark:hover:bg-gray-600 transition-all font-semibold shadow-lg hover:shadow-xl hover:-translate-y-0.5">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        GitHub
      </a>
      <a href="https://linkedin.com/in/roblohmann" target="_blank" rel="noopener noreferrer" 
         class="inline-flex items-center gap-2 px-8 py-4 bg-primary text-white rounded-xl hover:bg-accent transition-all font-semibold shadow-lg hover:shadow-xl hover:-translate-y-0.5">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        LinkedIn
      </a>
    </div>
  </section>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }
</style>

<script>
  // Animate skill bars on scroll
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bars = entry.target.querySelectorAll('.skill-bar');
        bars.forEach((bar) => {
          const level = bar.getAttribute('data-level');
          setTimeout(() => {
            (bar as HTMLElement).style.width = `${level}%`;
          }, 100);
        });
        observer.unobserve(entry.target);
      }
    });
  }, observerOptions);

  const skillSection = document.querySelector('section:has(.skill-bar)');
  if (skillSection) {
    observer.observe(skillSection);
  }
</script>
