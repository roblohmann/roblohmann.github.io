---
interface Props {
  name: string;
  title: string;
  description: string;
  imageSrc?: string;
  socials?: Array<{
    name: string;
    url: string;
    icon: string;
  }>;
}

const { name, title, description, imageSrc = '/images/profile.jpg', socials = [] } = Astro.props;
---

<section class="bg-primary text-white">
  <div class="max-w-6xl mx-auto px-8 sm:px-12 lg:px-16 py-16">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold mb-4">{name}</h1>
        <p class="text-xl text-blue-100 mb-6">{title}</p>
        <p class="text-lg text-blue-50 mb-8 leading-relaxed">{description}</p>
        
        {socials.length > 0 && (
          <div class="flex flex-wrap gap-4">
            {socials.map((social) => (
              <a 
                href={social.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-white text-primary hover:bg-blue-50 rounded-lg transition-all font-medium border border-white"
              >
                <span>{social.icon}</span>
                <span>{social.name}</span>
              </a>
            ))}
          </div>
        )}
      </div>
      
      <div class="flex justify-start md:justify-start">
        <img 
          src={imageSrc} 
          alt={name}
          class="rounded-full shadow-xl w-64 h-64 object-cover border-4 border-white"
        />
      </div>
    </div>
  </div>
</section>
